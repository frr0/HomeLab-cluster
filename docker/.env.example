# Server Configuration
SERVER_LAN_IP=192.168.1.100
SERVER_TAILSCALE_IP=100.64.0.10
TIMEZONE=Europe/Rome
PUID=1000
PGID=1000

# Storage Mounts
DATA_DIR=/home/server/homelab-storage

# Application Secrets (Sample values - update for production)
PAPERLESS_SECRET_KEY=change-this-to-a-secure-random-paperless-key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=SamplePaperlessPassword123!

FIREFLY_APP_KEY=base64:32-byte-random-secure-string-here
FIREFLY_DB_ROOT_PASSWORD=SampleRootDbPassword123!
FIREFLY_DB_USER=firefly
FIREFLY_DB_PASSWORD=SampleUserDbPassword123!
FIREFLY_DB_NAME=firefly

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SampleGrafanaPassword123!
